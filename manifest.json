{
  "manifest_version": 3,
  "name": "Kick Yayın Bildirici",
  "version": "1.4.1",
  "description": "Seçtiğiniz Kick yayıncılarını anlık takip edin.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.kick.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kick Takipçisi",
    "default_icon": "icon/icon.png"
  },
  "icons": {
    "16": "icon/icon.png",
    "48": "icon/icon.png",
    "128": "icon/icon.png"
  }
}
