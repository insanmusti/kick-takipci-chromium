{
  "manifest_version": 3,
  "name": "Kick Yayın Bildirici",
  "version": "1.0.0",
  "description": "Seçtiğiniz Kick yayıncılarını takip edin.",
  "permissions": [
    "storage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://*.kick.com/*",
    "https://kick.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://*.kick.com data: blob:;"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kick Takipçisi",
    "default_icon": "icon/icon.png"
  },
  "icons": {
    "16": "icon/icon.png",
    "48": "icon/icon.png",
    "128": "icon/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kick-notifier@local.extension",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}